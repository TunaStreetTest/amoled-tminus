{
    "type": "viewScreen",
    "id": "home",
    "style": {
        "bgColor": "#000000",
        "padding": 0
    },
    "commonProps": {
        "scrollable": false,
        "clickable": true
    },
    "layout": {
        "type": "flex",
        "flexFlow": "column",
        "mainAlign": "start",
        "crossAlign": "center",
        "gap": 4
    },
    "events": [
        {
            "type": "gesture",
            "action": "tminus.gesture"
        }
    ],
    "children": [
        {
            "type": "container",
            "id": "topbar",
            "placement": {
                "mode": "flow",
                "width": 368,
                "height": 34
            },
            "style": {
                "bgColor": "#000000",
                "padding": 0
            },
            "commonProps": {
                "scrollable": false,
                "clickable": false
            },
            "layout": {
                "type": "flex",
                "flexFlow": "row",
                "mainAlign": "spaceBetween",
                "crossAlign": "center",
                "gap": 4
            },
            "children": [
                {
                    "type": "label",
                    "id": "nav_prev",
                    "placement": {
                        "mode": "flow",
                        "width": 44,
                        "height": 34
                    },
                    "style": {
                        "textColor": "#4a4a4a",
                        "fontSize": 26,
                        "textAlign": "center"
                    },
                    "commonProps": {
                        "clickable": true
                    },
                    "labelProps": {
                        "text": "«"
                    },
                    "events": [
                        {
                            "type": "clicked",
                            "effects": [
                                {
                                    "type": "emitAction",
                                    "action": "tminus.prev",
                                    "requireValidPress": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "brand",
                    "placement": {
                        "mode": "flow",
                        "flexGrow": 1,
                        "height": 24
